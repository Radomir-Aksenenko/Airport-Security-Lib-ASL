{
  "$schema": "http://json.schemastore.org/template",
  "author": "ASL",
  "classifications": [ "Game", "Mod", "ASL" ],
  "identity": "ASL.Templates.Content",
  "name": "ASL content mod",
  "description": "No-code ASL content mod: swaps a named game texture for your own PNG. Includes a README on finding texture names.",
  "shortName": "asl-content",
  "sourceName": "MyMod",
  "tags": {
    "type": "project"
  },
  "symbols": {
    "author": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "yourname",
      "replaces": "yourname",
      "description": "Author name written to manifest.json and used as the middle part of the mod id."
    },
    "lowerAuthor": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "author",
        "toLower": true
      }
    },
    "lowerName": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      }
    },
    "modId": {
      "type": "generated",
      "generator": "join",
      "replaces": "com.yourname.mymod",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "com." },
          { "type": "ref", "value": "lowerAuthor" },
          { "type": "const", "value": "." },
          { "type": "ref", "value": "lowerName" }
        ]
      }
    }
  }
}
