<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet new template pack for ASL mods. Packs everything under content/ into ASL.Templates.<version>.nupkg.
    Nothing here compiles: the template projects inside content/ are data, not part of this project.

      cd templates
      dotnet pack -o <out-dir>
      dotnet new install <out-dir>/ASL.Templates.2.0.0.nupkg
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>ASL.Templates</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <Title>ASL Templates</Title>
    <Authors>Radomir Aksenenko</Authors>
    <Description>dotnet new templates for ASL (Airport Security Lib) mods: compiled DLL, script, content and declarative UI.</Description>
    <PackageTags>dotnet-new;templates;asl;bepinex;airport-security-sucks</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- Nothing in this project compiles; the template sources must not be picked up as code. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Each template folder lands at content/<shortName>/... inside the package (no doubled "content"). -->
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**"
             PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
