<Project>
  <!--
    Shared settings for the compile-check STUB interop assemblies. This file intentionally shadows the
    repo-root Directory.Build.props (MSBuild only imports the nearest one): the stubs have their own
    output location and must not pick up the game-oriented settings (GamePath, deploy targets, ...).

    Stubs are an APPROXIMATION of the game's Il2CppInterop-generated assemblies, good enough to
    type-check ASL / mod code on a machine without the game. See ../README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Il2CppInterop-generated assemblies are versioned 4.0.0.0 here (Il2CppInterop.Runtime references Il2Cppmscorlib 4.0.0.0). -->
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <Version>4.0.0</Version>

    <!-- Where the stubs are written (build.sh passes these; defaults match build.sh). -->
    <StubCoreDir Condition="'$(StubCoreDir)' == ''">$(MSBuildThisFileDirectory)../out/game/BepInEx/core</StubCoreDir>
    <StubOutDir Condition="'$(StubOutDir)' == ''">$(MSBuildThisFileDirectory)../out/game/BepInEx/interop</StubOutDir>
    <OutDir>$(StubOutDir)/</OutDir>

    <!-- Stubs are deliberately sloppy: members hide/shadow, bodies are `throw null`, etc. -->
    <NoWarn>$(NoWarn);CS0108;CS0109;CS0114;CS0067;CS0649;CS0169;CS0660;CS0661;CS0824;CS0626;CS1591;CS0219;CS8981;CS0618;CS0809</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The REAL Il2CppInterop runtime (never stubbed): Il2CppObjectBase, Il2CppType, arrays, DelegateSupport... -->
  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(StubCoreDir)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(StubCoreDir)/Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
